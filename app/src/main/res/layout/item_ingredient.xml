<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="#F1F8E9">

    <TextView
        android:id="@+id/txtIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient name"
        android:textColor="#1B5E20"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Quantity: 1 kg"
        android:textColor="#333333"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Expiry date: Not specified"
        android:textColor="#555555"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnEditIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Edit Ingredient" />

    <Button
        android:id="@+id/btnDeleteIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Ingredient"
        android:textColor="#B3261E" />

</LinearLayout>
