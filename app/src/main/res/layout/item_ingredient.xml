<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_pantry_card"
    android:elevation="3dp">

    <TextView
        android:id="@+id/txtIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient name"
        android:textColor="#204C37"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtIngredientQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#E7F1E5"
        android:padding="8dp"
        android:text="Quantity"
        android:textColor="#204C37"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Expiry date"
        android:textColor="#6B756D"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#F28C28"
            android:text="Edit"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#FBE8E6"
            android:text="Delete"
            android:textColor="#B3261E"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>