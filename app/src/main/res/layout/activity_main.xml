<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Brand accent -->
        <View
            android:layout_width="52dp"
            android:layout_height="6dp"
            android:layout_marginBottom="24dp"
            android:background="#F28C28" />

        <!-- Welcome section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR KITCHEN, SIMPLIFIED"
            android:textColor="#718071"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Smart Pantry\nManager"
            android:textColor="#204C37"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:text="Make the most of your ingredients.\nPlan meals and reduce food waste."
            android:textColor="#647066"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <!-- Dashboard welcome card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/dashboard_card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A smarter way to cook"
                android:textColor="#204C37"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keep track of your pantry, discover recipes, and make every ingredient count."
                android:textColor="#536357"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Navigation heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="EXPLORE YOUR KITCHEN"
            android:textColor="#204C37"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- My Pantry -->
        <Button
            android:id="@+id/btnPantry"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#F28C28"
            android:text="My Pantry     →"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:elevation="2dp" />

        <!-- Suggested Recipes -->
        <Button
            android:id="@+id/btnSuggestions"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#E5EFE2"
            android:text="Suggested Recipes     →"
            android:textColor="#204C37"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:elevation="1dp" />

        <!-- Settings -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#FFFFFF"
            android:text="Settings"
            android:textColor="#454D47"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:elevation="1dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="A little smarter. A little greener."
            android:textColor="#829087"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
